python3 -c "
import os, re

file_name = 'Dashbet3.html.html'
if os.path.exists(file_name):
    with open(file_name, 'r', encoding='utf-8') as f:
        content = f.read()

    # 🔄 ሁሉንም የ localhost እና 127.0.0.1 ሊንኮች ወደ relative ማጽዳት
    content = re.sub(r'http://localhost:\d+', '', content)
    content = re.sub(r'http://127\.0\.0\.1:\d+', '', content)
    content = re.sub(r'http://192\.168\.\d+\.\d+:\d+', '', content)

    with open(file_name, 'w', encoding='utf-8') as f:
        f.write(content)
    print('✅ ሁሉም የሊንክ ስህተቶች በራስ-ሰር ተስተካክለዋል!')
else:
    print('❌ Dashbet3.html.html ፋይል አልተገኘም!')
"
